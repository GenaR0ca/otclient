HelperTitle < Label
  color: #f0c040
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: prev.bottom
  margin-top: 10

HelperLabel < Label
  anchors.left: parent.left
  anchors.top: prev.bottom
  margin-top: 9
  width: 200
  text-auto-resize: false

HelperNumber < SpinBox
  anchors.left: prev.right
  anchors.verticalCenter: prev.verticalCenter
  margin-left: 4
  width: 48
  height: 20
  buttons: true
  mouse-scroll: true

HelperCheck < CheckBox
  anchors.left: parent.left
  anchors.top: prev.bottom
  margin-top: 6
  width: 320

HelperSubCheck < HelperCheck
  margin-left: 18
  width: 300

HelperSpellIcon < UIWidget
  size: 34 34
  border-width: 1
  border-color: #5a5a5a
  background-color: #00000077
  padding: 1
  focusable: false

HelperSpellSlot < Panel
  height: 36
  phantom: false
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: prev.bottom
  margin-top: 4

  HelperSpellIcon
    id: icon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    phantom: true

  Label
    id: name
    anchors.left: icon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    phantom: true
    width: 120
    text-auto-resize: false
    color: #dfdfdf

HelperBuffSlot < Panel
  size: 104 54
  phantom: false

  HelperSpellIcon
    id: icon
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    phantom: true

  Label
    id: name
    anchors.top: icon.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    text-align: center
    phantom: true
    font: Verdana-10px-antialiased
    color: #c0c0c0

HelperPickerRow < UIWidget
  height: 36
  focusable: false
  background-color: alpha
  $hover:
    background-color: #ffffff22

  HelperSpellIcon
    id: icon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    phantom: true

  Label
    id: name
    anchors.left: icon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    phantom: true


HelperCasterPanel < Panel
  Label
    id: basicTitle
    anchors.left: parent.left
    anchors.top: parent.top
    color: #f0c040

  HelperSpellSlot
    id: basicSlot

  Label
    id: skill1Title
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 6
    color: #f0c040

  HelperSpellSlot
    id: skill1Slot

    ComboBox
      id: mode
      anchors.right: value.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 4
      width: 110

    SpinBox
      id: value
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      width: 44
      height: 20
      minimum: 1
      maximum: 60
      buttons: true
      mouse-scroll: true

  Label
    id: skill2Title
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 6
    color: #f0c040

  HelperSpellSlot
    id: skill2Slot

    ComboBox
      id: mode
      anchors.right: value.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 4
      width: 110

    SpinBox
      id: value
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      width: 44
      height: 20
      minimum: 1
      maximum: 60
      buttons: true
      mouse-scroll: true

  Label
    id: buffTitle
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 8
    color: #f0c040

  Panel
    id: buffs
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 4
    height: 54
    layout:
      type: horizontalBox
      spacing: 4

  HelperLabel
    id: rangeLabel
    margin-top: 10

  HelperNumber
    id: range
    minimum: 1
    maximum: 8

  HelperCheck
    id: returnHome
    anchors.top: rangeLabel.bottom
    margin-top: 8

  HelperLabel
    id: returnDelayLabel
    margin-left: 18
    width: 182

  HelperNumber
    id: returnDelay
    minimum: 0
    maximum: 60

  HelperCheck
    id: chase
    anchors.top: returnDelayLabel.bottom
    margin-top: 8

HelperHealingPanel < Panel
  Label
    id: potionTitle
    anchors.left: parent.left
    anchors.top: parent.top
    color: #f0c040

  HelperLabel
    id: hpLabel

  HelperNumber
    id: hp
    minimum: 0
    maximum: 100

  HelperLabel
    id: mpLabel
    anchors.top: hpLabel.bottom

  HelperNumber
    id: mp
    minimum: 0
    maximum: 100

  HelperTitle
    id: healTitle
    anchors.top: mpLabel.bottom
    margin-top: 16

  HelperLabel
    id: healSelfLabel

  HelperNumber
    id: healSelf
    minimum: 0
    maximum: 100

  HelperLabel
    id: healPartyLabel
    anchors.top: healSelfLabel.bottom

  HelperNumber
    id: healParty
    minimum: 0
    maximum: 100

  Label
    id: healNote
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: healPartyLabel.bottom
    margin-top: 10
    text-wrap: true
    text-auto-resize: true
    color: #a0a0a0

HelperLootPanel < Panel
  HelperLabel
    id: lootRangeLabel
    anchors.top: parent.top
    margin-top: 2

  HelperNumber
    id: lootRange
    minimum: 1
    maximum: 8

  HelperCheck
    id: lootAll
    anchors.top: lootRangeLabel.bottom
    margin-top: 12

  HelperCheck
    id: lootSelected

  HelperSubCheck
    id: lootJewel

  HelperSubCheck
    id: lootZen

  HelperSubCheck
    id: lootGear

  HelperSubCheck
    id: lootExc

  HelperSubCheck
    id: lootScroll

  HelperSubCheck
    id: lootOther

  TextEdit
    id: lootWords
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 4
    margin-left: 36
    height: 20

  Label
    id: lootNote
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 6
    text-wrap: true
    text-auto-resize: true
    color: #a0a0a0

HelperOtherPanel < Panel
  Label
    id: partyTitle
    anchors.left: parent.left
    anchors.top: parent.top
    color: #f0c040

  HelperCheck
    id: partyAccept

  HelperCheck
    id: partyReject

  Label
    id: partyNote
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 8
    text-wrap: true
    text-auto-resize: true
    color: #a0a0a0

  HelperTitle
    id: quiverTitle
    margin-top: 16

  HelperCheck
    id: autoQuiver

  HelperTitle
    id: hotkeyTitle
    margin-top: 16

  Label
    id: hotkeyLabel
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 10
    width: 200
    text-auto-resize: false

  Button
    id: hotkeyButton
    anchors.left: prev.right
    anchors.verticalCenter: prev.verticalCenter
    margin-left: 4
    width: 100

HelperHotkeyCapture < MainWindow
  id: mubiaHelperHotkey
  size: 300 130
  !text: tr('Atajo del Mubia Helper')

  Label
    id: info
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    text-wrap: true
    text-auto-resize: true
    text-align: center

  Label
    id: preview
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 8
    text-align: center
    color: #f0c040

  Button
    id: cancelButton
    !text: tr('Cancelar')
    width: 70
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: self:getParent():destroy()

HelperSpellPicker < MainWindow
  id: mubiaHelperPicker
  size: 260 340
  !text: tr('Elegir habilidad')
  @onEscape: self:destroy()

  ScrollablePanel
    id: list
    anchors.left: parent.left
    anchors.right: listScroll.left
    anchors.top: parent.top
    anchors.bottom: cancelButton.top
    margin-bottom: 8
    vertical-scrollbar: listScroll
    layout:
      type: verticalBox
      spacing: 2

  VerticalScrollBar
    id: listScroll
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: cancelButton.top
    margin-bottom: 8
    step: 38
    pixels-scroll: true

  Button
    id: cancelButton
    !text: tr('Cerrar')
    width: 70
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: self:getParent():destroy()


MainWindow
  id: mubiaHelperWindow
  size: 380 590
  !text: tr('Mubia Helper')
  @onEscape: modules.game_mubia_helper.toggleWindow()

  Label
    id: statusLabel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    text-align: center
    color: #ff6060

  Label
    id: costLabel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2
    text-align: center
    color: #c0c0c0

  TabBar
    id: tabBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 8

  Panel
    id: tabContent
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: tabBar.bottom
    anchors.bottom: startButton.top
    margin-top: 6
    margin-bottom: 8
    padding: 8
    border-width: 1
    border-color: #3a3a3a

  Button
    id: startButton
    width: 120
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    @onClick: modules.game_mubia_helper.toggleHelper()

  Button
    id: saveButton
    width: 80
    anchors.left: prev.right
    anchors.bottom: parent.bottom
    margin-left: 6
    @onClick: modules.game_mubia_helper.saveFromWindow()

  Button
    id: closeButton
    !text: tr('Cerrar')
    width: 70
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_mubia_helper.toggleWindow()
