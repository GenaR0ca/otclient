// Mubia Online: ventana "Select Character" estilo MU.
// 5 lugares en fila con el personaje grande, y botones Create / Salir / Connect.
// (La lógica sigue en characterlist.lua; los ids characters, accountStatusLabel y
//  autoReconnect se mantienen porque el código los usa.)

CharacterWidget < UIWidget
  size: 170 228
  focusable: true
  background-color: #00000099
  border-width: 1
  border-color: #3a2d1e
  padding: 4
  &updateOnStates: |
    function(self)
      local focused = self:isFocused()
      if focused then
        self:setBorderColor('#e8b84a')
        self:setBorderWidth(2)
        self:setBackgroundColor('#2a1d0ccc')
      else
        self:setBorderColor('#3a2d1e')
        self:setBorderWidth(1)
        self:setBackgroundColor('#00000099')
      end
      local name = self:getChildById('name')
      if name then name:setColor(focused and '#ffe9a8' or '#e0c27a') end
    end
  @onFocusChange: self:updateOnStates()
  @onSetup: self:updateOnStates()

  UICreature
    id: outfitCreatureBox
    size: 128 128
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 14
    phantom: true

  Label
    id: name
    anchors.top: outfitCreatureBox.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 14
    text-align: center
    font: verdana-11px-rounded
    color: #e0c27a
    phantom: true

  Label
    id: level
    &baseText: 'Nivel %s'
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    text-align: center
    font: verdana-11px-antialised
    color: #dfdfdf
    phantom: true

  Label
    id: vocation
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    text-align: center
    font: verdana-11px-antialised
    color: #9fd0ff
    phantom: true

MubiaEmptySlot < UIWidget
  size: 170 228
  focusable: false
  background-color: #00000066
  border-width: 1
  border-color: #2a2218
  @onClick: MubiaCreate.open()
  $hover:
    background-color: #1a120899
    border-color: #6b5530

  Label
    id: emptyText
    anchors.centerIn: parent
    text-align: center
    text-auto-resize: true
    font: verdana-11px-antialised
    color: #8a7a5a
    !text: tr('+ Crear\npersonaje')
    phantom: true

MubiaBigButton < Button
  size: 120 28
  font: verdana-11px-rounded

StaticWindow
  id: charactersWindow
  !text: tr('Seleccionar personaje')
  size: 940 372
  anchors.horizontalCenter: parent.horizontalCenter
  anchors.bottom: parent.bottom
  margin-bottom: 60
  draggable: false
  visible: false
  @onEnter: CharacterList.doLogin()
  @onEscape: CharacterList.hide(true)
  @onSetup: |
    g_keyboard.bindKeyPress('Left', function() self:getChildById('characters'):focusPreviousChild(KeyboardFocusReason) end, self)
    g_keyboard.bindKeyPress('Right', function() self:getChildById('characters'):focusNextChild(KeyboardFocusReason) end, self)

  HorizontalList
    id: characters
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 232
    background-color: alpha
    border-width: 0
    padding: 2
    focusable: false
    auto-focus: first
    horizontal-scrollbar: characterListScrollBar
    layout:
      type: horizontalBox
      spacing: 10
      fit-children: false

  HorizontalScrollBar
    id: characterListScrollBar
    anchors.top: characters.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    step: 60
    pixels-scroll: true
    margin-top: 2

  Label
    id: accountStatusLabel
    visible: false

  Label
    id: mubiaCountLabel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: buttonCreate.top
    margin-bottom: 8
    text-align: center
    color: #c0a060
    font: verdana-11px-antialised

  Button
    id: autoReconnect
    visible: false
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    $!on:
      image-color: red
    $on:
      image-color: green

  MubiaBigButton
    id: buttonCreate
    !text: tr('Create')
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    @onClick: MubiaCreate.open()

  MubiaBigButton
    id: buttonMenu
    !text: tr('Salir')
    anchors.left: prev.right
    anchors.bottom: parent.bottom
    margin-left: 10
    @onClick: CharacterList.hide(true)

  MubiaBigButton
    id: buttonOk
    !text: tr('Connect')
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: CharacterList.doLogin()
