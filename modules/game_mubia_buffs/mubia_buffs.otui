MubiaBuffsPanel < UIWidget
  id: mubiaBuffsPanel
  width: 150
  height: 20
  anchors.top: parent.top
  anchors.left: parent.left
  margin-top: 6
  margin-left: 6
  padding: 4
  background-color: #00000099
  border-width: 1
  border-color: #6b5a3a
  phantom: true
  focusable: false

MubiaBuffRow < UIWidget
  height: 28
  anchors.left: parent.left
  anchors.right: parent.right
  phantom: true

  Label
    id: name
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: time.left
    height: 13
    font: verdana-11px-rounded
    color: #9fe39f
    text-auto-resize: false
    phantom: true

  Label
    id: time
    anchors.top: parent.top
    anchors.right: parent.right
    width: 44
    height: 13
    font: verdana-11px-rounded
    color: #ffffff
    text-align: right
    phantom: true

  Label
    id: text
    anchors.top: name.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 13
    font: verdana-11px-rounded
    color: #c0c0c0
    text-auto-resize: false
    phantom: true
